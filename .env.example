# Copy to .env.local for local testing, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Gmail account that sends the emails + its 16-character app password (myaccount.google.com/apppasswords)
GMAIL_USER=yourbrand@gmail.com
GMAIL_APP_PASSWORD=
# Where new-order notifications go (defaults to GMAIL_USER)
ORDER_NOTIFY_EMAIL=

# Admin dashboard (/admin)
ADMIN_PASSWORD=
# Any long random string (32+ characters); changing it logs everyone out
ADMIN_SESSION_SECRET=
